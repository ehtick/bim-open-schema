<Project>
  <!--
    When this repo is a submodule of a host repo (bim-open-toolkit), the host's
    Directory.Build.props sits above us and wins for every property it defines.
    Standalone, nothing is found above and the defaults below apply.
  -->
  <PropertyGroup>
    <_HostBuildProps>$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))</_HostBuildProps>
  </PropertyGroup>
  <Import Project="$(_HostBuildProps)" Condition="'$(_HostBuildProps)' != ''" />

  <PropertyGroup>
    <Ara3DVersion Condition="'$(Ara3DVersion)' == ''">1.6.1</Ara3DVersion>
    <Version Condition="'$(Version)' == ''">$(Ara3DVersion)</Version>
    <AssemblyVersion Condition="'$(AssemblyVersion)' == ''">$(Ara3DVersion)</AssemblyVersion>
    <FileVersion Condition="'$(FileVersion)' == ''">$(Ara3DVersion)</FileVersion>

    <Authors Condition="'$(Authors)' == ''">Ara 3D Inc.</Authors>
    <Company Condition="'$(Company)' == ''">Ara 3D Inc.</Company>
    <PackageLicenseExpression Condition="'$(PackageLicenseExpression)' == ''">MIT</PackageLicenseExpression>
    <PackageProjectUrl Condition="'$(PackageProjectUrl)' == ''">https://github.com/ara3d/bim-open-schema</PackageProjectUrl>
    <RepositoryUrl Condition="'$(RepositoryUrl)' == ''">https://github.com/ara3d/bim-open-schema</RepositoryUrl>
    <RepositoryType Condition="'$(RepositoryType)' == ''">git</RepositoryType>
    <PackageOutputPath Condition="'$(PackageOutputPath)' == ''">$(MSBuildThisFileDirectory)artifacts</PackageOutputPath>
  </PropertyGroup>
</Project>
